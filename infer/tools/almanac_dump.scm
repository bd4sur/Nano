;; almanac_dump.scm —— 黄历差分回归的 Scheme 侧输出器（由 tools/almanac_difftest.py 生成/运行）
;;
;; 运行根目录须含 `app/`（软链到 infer/app），因为 almanac.scm 的 import 路径是
;; "app/lib/almanac_data.scm"（与灵机 App 在业务资源根下的路径一致）。
;;
;; 输出格式与 tools/gen_almanac_tables.c 的 `ref` 模式逐字段对应（TAB 分隔）。
(import AL "app/lib/almanac.scm")
(native String)

(define pad2 (lambda (n) (if (< n 10) (String.concat "0" (String.atom_to_string n))
                                  (String.atom_to_string n))))

(define join (lambda (L sep)
    (define n (length L))
    (define i 0)
    (define out "")
    (while (< i n)
        (if (> i 0) (set! out (String.concat out sep)) #f)
        (set! out (String.concat out (get_item L i)))
        (set! i (+ i 1)))
    out))

(define tab (lambda (s) (display s) (display "\t")))

;; 数字元组拼串（String.concat 只接受字符串）
(define joinn (lambda (L sep)
    (define n (length L))
    (define i 0)
    (define out "")
    (while (< i n)
        (if (> i 0) (set! out (String.concat out sep)) #f)
        (set! out (String.concat out (String.atom_to_string (get_item L i))))
        (set! i (+ i 1)))
    out))

(define line (lambda (y m d h mi)
    (define R (AL.calc y m d h mi))
    (if (== R #f)
        (begin (display y) (display "-") (display m) (display "-") (display d)
               (display " ") (display h) (display ":") (display (pad2 mi))
               (display "\tERR") (newline))
        (begin
          (display y) (display "-") (display m) (display "-") (display d)
          (display " ") (display h) (display ":") (display (pad2 mi)) (display "\t")
          (tab (AL.bazi R))
          (tab (AL.overall R))
          (tab (AL.week R))
          (tab (AL.zodiac R))
          (tab (AL.star28 R))
          (tab (AL.officer R))
          (tab (AL.god R))
          (tab (AL.meridian R))
          (tab (AL.meridian_yi R))
          (tab (AL.meridian_ji R))
          (tab (AL.meridian_note R))
          (tab (join (AL.good R) "/"))
          (tab (join (AL.bad R) "/"))
          (tab (AL.fly R))
          (tab (AL.fetal R))
          (tab (AL.peng R))
          (tab (join (AL.hourluck R) "/"))
          (tab (join (AL.dirs R) "/"))
          (display (joinn (AL.lunar R) ","))
          (display "\t")
          (display (AL.next_solar R))
          (display "\t")
          (display (join (get_item R 20) "/"))
          (display "\t")
          (display (join (get_item R 21) "/"))
          (display "\t")
          (display (get_item R 22))
          (display "\t")
          (display (get_item R 23))
          (newline)))))

(define hlist 'HOURS)
(define mlist 'MINS)
(define di 0)
(define hi 0)
(define ymdv #f)
(while (< di COUNT)
    (set! ymdv (AL.ymd (+ START di)))
    (set! hi 0)
    (while (< hi (length hlist))
        (line (get_item ymdv 0) (get_item ymdv 1) (get_item ymdv 2)
              (get_item hlist hi) (get_item mlist hi))
        (set! hi (+ hi 1)))
    (set! di (+ di 1)))
