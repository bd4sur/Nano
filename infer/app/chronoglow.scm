(define STYLE 1)
;; 粒子形状（底部第三枚按钮，三档）：
;;   0 = 圆点（fill_dot_aa r=1.55，慢速/微抖时是软边圆点，直径 ~3~4px）
;;   1 = 细点（fill_dot_aa r=0.62 ⇒ 覆盖率只延伸到 r+0.5 ≈ 1.1px，直径 1~2px 的点）
;;   2 = 短棒（2026-11-25 之前的原画法：永远一条两端各加恒定偏移的 AA 线）
(define RENDER 0)
;; 闪烁模式（底部第四枚按钮，三档）：
;;   0 = 随机 —— 每颗粒子独立乱闪（不看空间位置）；
;;   1 = 波纹 ——（默认）亮度相位随粒子序号走，于是有一条从秒位（右）向左传播的光晕波；
;;   2 = 常亮 —— 恒定亮度，完全不闪。
(define TWK 1)
;; 触点排斥：按住屏幕时把附近粒子推开，松手后弹簧自然把它们收回字形
(define REPT 0)                    ; 剩余排斥拍数（>0 生效；点按也会给 8 拍脉冲）
(define GUARD 12)                  ; 启动保护：前 12 拍忽略触屏（吃掉从菜单点进来的余波）
(define REPR 58.0)                 ; 排斥半径（px）
(define REPR2 3364.0)              ; = REPR²
(define RTX 0.0)                   ; 当前触点
(define RTY 0.0)
(define PRESSED #f)
(define BHOLD 0)                   ; 本次按下落在哪颗按钮：0 无 / 1 样式 / 2 配色 / 3 粒子形状 / 4 闪烁（高亮用）
;; 底部四枚按钮（左上角 + 尺寸，一排四个，左右各留 8px）：
;;   ① 样式 实心/描边  ② 配色 1..6  ③ 粒子 圆点/短棒  ④ 闪烁 波纹/随机/常亮
;; 宽度按最长的标签留（5 个汉字的 12px 字模 = 60px + 两侧内边距）：76 / 58 / 76 / 76。
(define B1X 8.0)   (define B1Y 212.0) (define B1W 76.0) (define B1H 20.0)
(define B2X 90.0)  (define B2Y 212.0) (define B2W 58.0) (define B2H 20.0)
(define B3X 154.0) (define B3Y 212.0) (define B3W 76.0) (define B3H 20.0)
(define B4X 236.0) (define B4Y 212.0) (define B4W 76.0) (define B4H 20.0)
;; 重组冲刺（打乱后短暂改用直接指数趋近，十几拍把粒子干净地收成字形）
(define BOOST 0)                   ; >0 = 正处于"重组冲刺"的剩余拍数
(define SPK 0.26)                  ; 弹簧系数：把粒子拉回平衡位置（字形点）的刚度
(define DMP 0.86)                  ; 阻尼：速度每拍乘这个系数（<1 才有摩擦）
;; 热振动（分子在平衡位置附近的小幅快振）：**只作用在绘制位置**上，物理位置 x,y 不动 ——
;; 两个不同频率的正弦 + 每颗自己的随机相位（GPH），幅度 AJ、频率 8.5/10 Hz
;; （24fps 下每周期 2.4~2.8 帧）。这样：
;;   · 幅度小（RMS ≈0.6px，峰峰 1.7px）而速度快，且**没有低频成分** ——
;;     不会出现"粒子绕着平衡位置慢慢蠕动/绕圈"（那是旧版旋涡力与欠阻尼弹簧的病）；
;;   · 物理位置始终收敛到字形点 ⇒ 笔画不会因为抖动而结团、露缝，只是"珠子在原地颤"。
(define AJ 1.20)                   ; 振动幅度（px，正弦峰值；峰峰 2.4px ≈ 0.9 个点距）
(define WJX 29.0)                  ; x 方向基准角频率（rad/s）≈ 4.6 Hz（8.0 → 6.4 → 4.6）
(define WJY 35.2)                  ; y 方向基准角频率（rad/s）≈ 5.6 Hz（9.6 → 7.7 → 5.6）
;; **频率必须明显低于帧率的一半，否则混叠**：24fps 的奈奎斯特是 12Hz，但"看起来像平滑振动"
;; 的经验上限只有 fps/4 ≈ 6Hz —— 每周期少于 ~4 帧时，每拍相位推进 >90°，看到的就不是
;; 往复而像"每帧乱跳"；而且所有粒子共用同一个帧时钟，欠采样会把各自的抖动混叠成
;; **同一种拍频**，整片画面于是像"一起刷新/频闪"（用户实测反馈，正是这个原因）。
;; 乘上 0.58~1.08 的每颗系数后：x 为 2.7~5.0Hz、y 为 3.2~6.0Hz（每周期 4~9 帧）。
;; 每颗粒子的频率还要再乘一个 0.58~1.08 的随机系数（由它自己的 GPH 派生），x/y 各取一个：
;; **若所有粒子同频，整片看起来就是"一起闪"**（自由度低、像一块振动的板）；
;; 各自频率不同才是"一堆分子各自乱颤"。

;; ---- 颜色寄存器（热路径不写 define、不返回列表）-------------------------
(define HR 0.0)
(define HG 0.0)
(define HB 0.0)
(define _h6 0.0)
(define _hi 0.0)
(define _hf 0.0)
(define _p 0.0)
(define _q 0.0)
(define _w 0.0)

(define hsv
  (lambda (h s v)
    (set! _h6 (* (mod (+ h 64.0) 1.0) 6.0))
    (set! _hi (Math.floor _h6))
    (set! _hf (- _h6 _hi))
    (set! _p (* v (- 1.0 s)))
    (set! _q (* v (- 1.0 (* s _hf))))
    (set! _w (* v (- 1.0 (* s (- 1.0 _hf)))))
    (cond ((< _hi 1.0) { (set! HR (* v 255.0)) (set! HG (* _w 255.0)) (set! HB (* _p 255.0)) })
          ((< _hi 2.0) { (set! HR (* _q 255.0)) (set! HG (* v 255.0)) (set! HB (* _p 255.0)) })
          ((< _hi 3.0) { (set! HR (* _p 255.0)) (set! HG (* v 255.0)) (set! HB (* _w 255.0)) })
          ((< _hi 4.0) { (set! HR (* _p 255.0)) (set! HG (* _q 255.0)) (set! HB (* v 255.0)) })
          ((< _hi 5.0) { (set! HR (* _w 255.0)) (set! HG (* _p 255.0)) (set! HB (* v 255.0)) })
          (else       { (set! HR (* v 255.0)) (set! HG (* _p 255.0)) (set! HB (* _q 255.0)) }))))

;; ---- 启动：算槽位与粒子容量 ----------------------------------------------
(define build_layout
  (lambda ()
    (define i 0)
    (define x 0.0)
    (define w 0.0)
    ;; 单字容量 = 全部字形里的最大点数
    (set! MAXPT 0)
    (set! i 0)
    (while (< i NGLYPH) {
      (if (> (get_item GD_CNT i) MAXPT) (set! MAXPT (get_item GD_CNT i)) #f)
      (if (> (get_item GO_CNT i) MAXPT) (set! MAXPT (get_item GO_CNT i)) #f)
      (set! i (+ i 1))
    })
    ;; 总宽 = 6 个数字 + 2 个冒号（冒号两侧各加 COLMG 边距），水平居中
    (set! w (+ (* 6.0 GD_ADV) (* 2.0 (+ GD_CADV (* 2.0 COLMG)))))
    (set! X0 (/ (- 320.0 w) 2.0))
    (set! CLKW w)
    (set! SLOTX (cons 0.0 '())) (pop SLOTX)
    (set! x X0)
    (set! i 0)
    (while (< i 8) {
      (if (== (get_item SLOTD i) -1)
          { (push SLOTX (+ x COLMG)) (set! x (+ (+ x GD_CADV) (* 2.0 COLMG))) }
          { (push SLOTX x) (set! x (+ x GD_ADV)) })
      (set! i (+ i 1))
    })))

(define build_particles
  (lambda ()
    (set! GX (cons 0.0 '())) (pop GX)
    (set! GY (cons 0.0 '())) (pop GY)
    (set! GVX (cons 0.0 '())) (pop GVX)
    (set! GVY (cons 0.0 '())) (pop GVY)
    (set! GPH (cons 0.0 '())) (pop GPH)
    (define i 0)
    (define n (* 8 MAXPT))          ; 8 个槽（6 数字 + 2 冒号）× 单字容量
    (while (< i n) {
      (push GX (* (Math.random) 320.0))
      (push GY (* (Math.random) 240.0))
      (push GVX 0.0)
      (push GVY 0.0)
      (push GPH (* (Math.random) 6.2832))
      (set! i (+ i 1))
    })
    ;; 星空：初始半径按 sqrt 分布铺开（面积均匀），角度随机
    (set! DX (cons 0.0 '())) (pop DX)
    (set! DY (cons 0.0 '())) (pop DY)
    (define ra 0.0)
    (define aa 0.0)
    (set! i 0)
    (while (< i NSTAR) {
      (set! ra (* 260.0 (Math.sqrt (Math.random))))     ; r ∈ [0, 260]
      (set! aa (* (Math.random) 6.2832))
      (push DX (+ SCX (* ra (Math.cos aa))))
      (push DY (+ SCY (* ra (Math.sin aa))))
      (set! i (+ i 1))
    })
    ))

;; ---- 时间 → 6 个数字 ------------------------------------------------------
(define read_time
  (lambda ()
    (define sod (mod (+ (Time.utc_sod) TZ_SEC) 86400))
    (define hh (Math.floor (/ sod 3600.0)))
    (define mm (Math.floor (/ (mod sod 3600.0) 60.0)))
    (define ss (Math.floor (mod sod 60.0)))
    (set_item! DIG 0 (Math.floor (/ hh 10.0)))
    (set_item! DIG 1 (Math.floor (mod hh 10.0)))
    (set_item! DIG 2 (Math.floor (/ mm 10.0)))
    (set_item! DIG 3 (Math.floor (mod mm 10.0)))
    (set_item! DIG 4 (Math.floor (/ ss 10.0)))
    (set_item! DIG 5 (Math.floor (mod ss 10.0)))))

;; ---- 背景：极暗竖直渐变 + 秒进度光带 --------------------------------------
(define draw_bg
  (lambda (t)
    (define i 0)
    (define k 0.0)
    (Gfx.clear)
    ;; 12 条 20px 色带做极暗渐变（**不要**用大 fill_circle_aa：代价随面积走，且有硬边）
    (set! i 0)
    (while (< i 12) {
      (set! k (/ (- (Math.abs (- (* i 20.0) 105.0)) 105.0) 105.0))
      (set! k (* k k))
      (Gfx.fill_rect 0.0 (* i 20.0) 320.0 20.0
                     (+ 3.0 (* 9.0 k)) (+ 5.0 (* 13.0 k)) (+ 11.0 (* 24.0 k)))
      (set! i (+ i 1))
    })
    ))

;; ---- 底部两个按钮：样式（描边/实心）、配色 --------------------------------
;; 画法与 app/lib/exit.scm 的按钮同款：圆角底 + 1px 描边 + 居中 12px 字。
(define button
  (lambda (bx by bw bh label active)
    (Gfx.rounded_rect bx by bw bh 5 5 5 5 96 110 132 1)
    (if active
        (Gfx.rounded_rect (+ bx 1.0) (+ by 1.0) (- bw 2.0) (- bh 2.0) 4 4 4 4 46 96 130 1)
        (Gfx.rounded_rect (+ bx 1.0) (+ by 1.0) (- bw 2.0) (- bh 2.0) 4 4 4 4 52 56 68 1))
    (Gfx.set_font 1)
    (Gfx.draw_text_centered 1 label (+ bx (* bw 0.5)) (+ by (* bh 0.5)) 226 232 242 1)))

(define draw_buttons
  (lambda ()
    (define b1on #f)
    (define b2on #f)
    (define b3on #f)
    (define b4on #f)
    (set! b1on (and PRESSED (== BHOLD 1)))
    (if (== STYLE 1) (button B1X B1Y B1W B1H "样式·实心" b1on)
                     (button B1X B1Y B1W B1H "样式·描边" b1on))
    (set! b2on (and PRESSED (== BHOLD 2)))
    (cond ((== PAL 0) (button B2X B2Y B2W B2H "配色·1" b2on))
          ((== PAL 1) (button B2X B2Y B2W B2H "配色·2" b2on))
          ((== PAL 2) (button B2X B2Y B2W B2H "配色·3" b2on))
          ((== PAL 3) (button B2X B2Y B2W B2H "配色·4" b2on))
          ((== PAL 4) (button B2X B2Y B2W B2H "配色·5" b2on))
          (else       (button B2X B2Y B2W B2H "配色·6" b2on)))
    ;; ③ 粒子形状：圆点 / 短棒
    (set! b3on (and PRESSED (== BHOLD 3)))
    (cond ((== RENDER 0) (button B3X B3Y B3W B3H "粒子·圆点" b3on))
          ((== RENDER 1) (button B3X B3Y B3W B3H "粒子·细点" b3on))
          (else          (button B3X B3Y B3W B3H "粒子·短棒" b3on)))
    ;; ④ 闪烁：波纹（默认）/ 随机 / 常亮
    (set! b4on (and PRESSED (== BHOLD 4)))
    (cond ((== TWK 0) (button B4X B4Y B4W B4H "闪烁·随机" b4on))
          ((== TWK 2) (button B4X B4Y B4W B4H "闪烁·常亮" b4on))
          (else       (button B4X B4Y B4W B4H "闪烁·波纹" b4on)))))

(define in_rect
  (lambda (px py bx by bw bh)
    (and (>= px bx) (< px (+ bx bw)) (>= py by) (< py (+ by bh)))))

;; ---- 星空粒子：从字块中心向四周**直线**散开（穿越星空）--------------------
;; 每颗：v = (p − C)·VK ⇒ 越远越快（透视加速），方向恒为径向（直线，不转弯）；
;; 跑出画面外 30px 就从中心附近重生（半径 10~56、角度随机），于是源源不断地"涌出来"。
;; 位置是唯一状态：速度与方向都由 (x,y) 与爆心的差得到，不存速度（省 2 个数组 + 读写）。
;; 画法：一条沿径向的短线（长度 = 速度 × SK，钳到 ±18px）+ 亮度随 d² 增长（远处更亮）。
(define draw_dust
  (lambda (t)
    (define i 0)
    (define x 0.0)
    (define y 0.0)
    (define vx 0.0)
    (define vy 0.0)
    (define ddx 0.0)
    (define ddy 0.0)
    (define d2 0.0)
    (define br 0.0)
    (define tx 0.0)
    (define ty 0.0)
    (define ra 0.0)
    (define aa 0.0)
    (set! i 0)
    (while (< i NSTAR) {
      (set! x (get_item DX i))
      (set! y (get_item DY i))
      (set! vx (* (- x SCX) VK))
      (set! vy (* (- y SCY) VK))
      (set! x (+ x vx))
      (set! y (+ y vy))
      ;; 出界 → 回中心附近重生（角度随机、半径 10~56，避免全都挤在一点）
      (if (or (< x -30.0) (> x 350.0) (< y -30.0) (> y 270.0))
          { (set! ra (+ 10.0 (* (Math.random) 46.0)))
            (set! aa (* (Math.random) 6.2832))
            (set! x (+ SCX (* ra (Math.cos aa))))
            (set! y (+ SCY (* ra (Math.sin aa))))
            (set! vx (* (- x SCX) VK))
            (set! vy (* (- y SCY) VK)) }
          #f)
      (set_item! DX i x) (set_item! DY i y)
      ;; 亮度：随 d²（到爆心的平方距离）增长 —— 不开放，省一次 sqrt
      (set! ddx (- x SCX))
      (set! ddy (- y SCY))
      (set! d2 (+ (* ddx ddx) (* ddy ddy)))
      (set! br (+ SB0 (* SB1 (* d2 SI2))))
      (if (> br 1.15) (set! br 1.15) #f)
      ;; 拖尾：沿速度反推（长度 ∝ 速度 ⇒ 远处拉成一条长线，近处只是个小点）
      (set! tx (* vx SK))
      (set! ty (* vy SK))
      (if (> tx SKMAX) (set! tx SKMAX) (if (< tx (- 0.0 SKMAX)) (set! tx (- 0.0 SKMAX)) #f))
      (if (> ty SKMAX) (set! ty SKMAX) (if (< ty (- 0.0 SKMAX)) (set! ty (- 0.0 SKMAX)) #f))
      (Gfx.draw_line_aa (- x tx) (- y ty) x y 1.0 (* 172.0 br) (* 205.0 br) (* 255.0 br))
      (set! i (+ i 1))
    })))

;; ---- 单颗粒子：弹簧 + 热噪声 + 加色圆点/光丝 --------------------------------
;; ---- 辉光：一次 (Gfx.fill_glow_aa) 取代"两层同心 alpha 圆" -------------------
;; 老做法是两个定值 alpha 圆（R / 0.58R，alpha 26/50）叠起来——它只是"两档台阶"
;; 而不是连续衰减：中心 27.8%、到 0.58R 骤降到 10.2%、到 R 一刀切为 0，放大看是一个
;; 有硬边的圆盘；而且每组 2 次圆角矩形（角部 8×8 超采样）≈ 6 µs。
;; 现在换成 graphics.c 的 gfx_fill_glow_anti_aliasing：强度剖面 (1−(d/R)²)²，
;; 中心平顶、边缘一阶导为 0，逐像素只有 2 乘 2 加、无开方无超采样 ⇒ 更平滑且更便宜。
(define halo
  (lambda (x y rad br)
    (Gfx.fill_glow_aa x y rad HR HG HB (* 0.26 br))))

(define step_particle
  (lambda (p tx ty hue t glow rep)
    (define x 0.0)
    (define y 0.0)
    (define vx 0.0)
    (define vy 0.0)
    (define br 0.0)
    (define sx 0.0)
    (define sy 0.0)
    (define ddx 0.0)
    (define ddy 0.0)
    (define d2 0.0)
    (define rf 0.0)
    (define bo 0)
    (define k 0.0)
    (define hv 0.0)
    (define bs 0.80)
    (define pk 0.0)
    (define env 0.0)
    (define g 0.0)
    (set! x (get_item GX p))
    (set! y (get_item GY p))
    ;; 物理（两种模式，都不含任何低频旋涡/蠕动力）：
    ;;  · 常态 —— 纯**弹簧 + 阻尼**：把粒子朝字形点拖过去，稳定后停在那里；
    ;;    热振动不在物理里，而是绘制时叠的偏移（见下面 AJ 的说明），所以不会积累、
    ;;    不会结团、也不会绕圈蠕动。
    ;;  · 重组冲刺（BOOST>0，整分钟打乱后的十几拍）—— 换成**直接指数趋近**：
    ;;    不会过冲、不会振铃，十几拍就能把炸散的粒子干净地收成字形。
    (set! bo BOOST)                     ; 只读一次全局（热路径上全局取值很贵）
    (cond ((> bo 0)
           { (set! vx (* 0.26 (- tx x)))
             (set! vy (* 0.26 (- ty y))) })
          (else
           { (set! vx (+ (* (get_item GVX p) DMP) (* (- tx x) SPK)))
             (set! vy (+ (* (get_item GVY p) DMP) (* (- ty y) SPK))) }))
    ;; 触点排斥：按住屏幕时把半径内的粒子沿径向推开（力度按 1−d²/R² 衰减）。
    ;; 不开方：方向用 (dx/R, dy/R) 近似即可，省一次 sqrt（每颗粒子每拍都算）。
    (if (== rep 0)
        #f
        { (set! ddx (- x RTX))
          (set! ddy (- y RTY))
          (set! d2 (+ (* ddx ddx) (* ddy ddy)))
          (if (< d2 REPR2)
              { (set! rf (- 1.0 (/ d2 REPR2)))
                (set! rf (* rf 20.0))
                (set! vx (+ vx (* rf (/ ddx REPR))))
                (set! vy (+ vy (* rf (/ ddy REPR)))) }
              #f) })
    (set! x (+ x vx))
    (set! y (+ y vy))
    (if (> bo 0)
        { (set_item! GVX p 0.0) (set_item! GVY p 0.0) }
        { (set_item! GVX p vx) (set_item! GVY p vy) })
    (set_item! GX p x) (set_item! GY p y)     ; ← 物理位置（不含振动）
    ;; 热振动：只在绘制时叠加（x/y 从此是"看起来在哪"，GX/GY 里存的仍是平衡位置）。
    ;; 每颗自己的频率（0.58~1.08 倍，由 GPH 派生；x/y 各一个）+ 每颗自己的相位 ⇒
    ;; 一堆独立振子，而不是同一块"振动的板"。
    (set! g (get_item GPH p))
    (set! x (+ x (* AJ (Math.sin (+ (* t (* WJX (+ 0.58 (* 0.50 (mod g 1.0)))))
                                   (* 3.7 g))))))
    (set! y (+ y (* AJ (Math.sin (+ (* t (* WJY (+ 0.58 (* 0.50 (mod (* 2.6 g) 1.0)))))
                                   (* 1.3 g))))))
    ;; 亮度分两份（这一条是"闪烁体现在粒子上、而不是光晕上"的关键）：
    ;;   bs —— **基础亮度**：波纹档的波值 / 常亮档的定值。**光晕（fill_glow_aa）只用它**，
    ;;         所以光晕不闪、不脉冲（否则整屏看的是"一团团光晕在呼吸"，粒子本身反而看不清）。
    ;;   br —— **粒子本体亮度** = bs × 闪烁系数：圆点/光丝用它，闪烁只发生在这里。
    ;; 闪烁（底部第四枚按钮，TWK 三档）
    ;;   0 随机 —— **每颗粒子独立乱闪**（波光粼粼）：靠"每颗不同的翻转时刻 + Weyl 序列取值"，
    ;;             与粒子序号（= 空间位置）无关：
    ;;               k  = floor(8t + 0.1592·GPH)          ; GPH 是每颗自己的随机相位（0..2π）
    ;;               hv = frac(k·φ + 0.1592·GPH)          ; φ=0.6180339887（黄金分割共轭）
    ;;             hv 在 [0,1) 上均匀（Weyl 序列），同一颗相邻两次翻转的值固定相差 0.618。
    ;;             **动态范围要拉大**（波光粼粼 = 大部分粒子半暗、少数粒子猛然亮成白点）：
    ;;               本体亮度 = 0.04 + 1.75·hv²（0.04~1.79，平方压低均值到 ~0.62 但保留高光）；
    ;;               hv>0.88（约 10%）再 ×3.2 ⇒ 白得发亮。光晕恒为 0.80 ⇒ 只有"点"在闪。
    ;;             **老写法是 sin(12.9898k + 78.233p)**：它是 p 的线性函数，k 每加 1
    ;;             整条图案就左移 0.17 个粒子 ⇒ 看起来仍是一条横向传播的波，与"波纹"档
    ;;             几乎一样（用户实测反馈"随机闪烁还是空间传播"，即此因）。
    ;;   1 波纹 —— **每秒一发、从左向右快速扫过的"脉冲波包"**（不是连续正弦）：
    ;;             包络 = (1 − ((x−PX)/PKS)²)²（紧支撑、边缘平滑），包内再叠一条
    ;;             cos(PKW·(x−PX)) 的振荡 ⇒ 一条宽约 140px 的亮带，内部 2~3 道波纹。
    ;;             bs = 0.26 + 1.15·env·(0.62 + 0.38·cos(...))，峰值 ≈ 1.41。
    ;;             PX 由 tick 按整秒推进：0.7 s 从 x=-70 扫到 x=390 ⇒ 约 660 px/s
    ;;             （24fps 下每拍 ~27px，包宽 ~140px，不至于跳帧）。
    ;;             扫完到下一整秒之间是**暗淡的底亮度 0.26**。
    ;;             **底亮度必须压得这么暗**：字形区里十几颗粒子的辉光重叠时 alpha 早就
    ;;             叠加到饱和（1−(1−a)^15 ≈ 93%），调制 gain 根本看不出变化 —— 实测底 0.64
    ;;             时脉冲只让 bin 亮度 +12~19%；压到 0.26 后脉冲带能到 2~3 倍。
    ;;             **为什么必须用屏幕 x（tx）而不是粒子序号 p**：p = 槽号×MAXPT + 点序号，
    ;;             而点序号是"绕字心极角"排序的 —— 按 p 走相位，图案会变成每颗数字内部
    ;;             ~7 条**绕字心旋转的亮暗弧**，根本看不到横向传播（用户实测反馈）。
    ;;             白闪仍按**每颗自己的随机相位**抽（hv>0.985，×2.6），与位置无关，
    ;;             免得那几颗闪点自己排出条纹抢掉脉冲的定向感。
    ;;   2 常亮 —— 本体与光晕都是 0.80，完全不闪（对照用）。
    (cond ((== TWK 0)
           { (set! bs 0.80)
             (set! k (Math.floor (+ (* t 8.0) (* 0.1592 (get_item GPH p)))))
             (set! hv (mod (+ (* k 0.6180339887) (* 0.1592 (get_item GPH p))) 1.0))
             (set! br (+ 0.04 (* 1.75 (* hv hv))))      ; hv² 压低均值、保留高光 → 波光粼粼
             (if (> hv 0.88) (set! br (* br 3.2)) #f) })
          ((== TWK 2)
           { (set! bs 0.80) (set! br 0.80) })
          (else
           { ;; 波纹：脉冲波包 —— 包络 (1−q²)²，包内叠 cos 振荡
             (set! pk (* (- tx PX) PKI))
             (set! env (- 1.0 (* pk pk)))
             (if (> env 0.0)
                 { (set! env (* env env))
                   (set! bs (+ 0.26 (* 1.15 (* env (+ 0.62 (* 0.38 (Math.cos (* PKW (- tx PX))))))))) }
                 (set! bs 0.26))
             (set! br bs)
             ;; 白闪：每颗自己的随机相位（不给空间图案，免得抢掉脉冲的定向感）
             (set! k (Math.floor (+ (* t 6.0) (* 0.1592 (get_item GPH p)))))
             (set! hv (mod (+ (* k 0.6180339887) (* 0.1592 (get_item GPH p))) 1.0))
             (if (> hv 0.985) (set! br (* br 2.6)) #f) }))
    (hsv (+ hue (* 0.05 (Math.sin (+ (* p 0.21) (* t 0.9))))) 0.42 1.0)
    ;; 粒子本体三档画法（底部第三枚按钮，RENDER）：
    ;;   0 **圆点**（默认，r=1.55）/ 1 **细点**（r=0.62）：永远只画圆点 ——
    ;;     `(Gfx.fill_dot_aa)` 是浮点圆心 + 1px 解析覆盖率，所以任何速度下都是软边圆点。
    ;;     **运动时不再叠"运动模糊"短线**（旧版在 |v| > 1.2 px/拍 时会额外画一条
    ;;     长度 2.6×速度、钳 ±4.5px 的加色线）：用户明确要求彻底去掉强行拖尾，
    ;;     代价是快速移动（换秒/重组/排斥）时看起来是"圆点瞬移"，不再有方向提示。
    ;;     细点 r=0.62 ⇒ 覆盖率只延伸到 r+0.5 = 1.12px：中心像素满覆盖、四邻 ~0.1，
    ;;     视觉直径 1~2px（"尘埃点"）；圆点 r=1.55 ⇒ 直径 ~3~4px（"光珠"）。
    ;;   2 **短棒**（2026-11-25 之前的原画法）：永远一条 AA 线，两端各加 ±1.5 的恒定对角
    ;;      偏移 —— 好处是恒定对角偏移保证了"零长也能画出来"，代价是静止时也是棒状。
    (if (== RENDER 2)
        { (set! sx (* vx 2.6))
          (set! sy (* vy 2.6))
          (if (> sx 4.5) (set! sx 4.5) (if (< sx -4.5) (set! sx -4.5) #f))
          (if (> sy 4.5) (set! sy 4.5) (if (< sy -4.5) (set! sy -4.5) #f))
          (Gfx.draw_line_aa (- (- x sx) 1.5) (- (- y sy) 1.5) (+ x 1.5) (+ y 1.5)
                            1.0 (* HR br) (* HG br) (* HB br)) }
        { (if (== RENDER 0)
              (Gfx.fill_dot_aa x y 1.55 (* HR br) (* HG br) (* HB br))
              (Gfx.fill_dot_aa x y 0.62 (* HR br) (* HG br) (* HB br))) })
    ;; 柔和辉光：**用基础亮度 bs**（不随闪烁变 —— 闪烁在粒子上，不在光晕上）
    (if glow
        (halo x y (+ 5.4 (* 1.8 bs)) bs)
        #f)))

;; ---- 一帧：读时间 → 逐槽把粒子拉向字形 -----------------------------------
;; 槽位与字形下标一一对应：数字槽取当前数字（0..9），冒号槽固定 10。
;; 每槽的粒子区间是 [slot*MAXPT, slot*MAXPT + cnt)，cnt 是当前字形的点数；
;; 多出来的槽位粒子本帧不动（下次字形变大时从原处飞回来）。
(define draw_clock
  (lambda (t)
    (define si 0)
    (define j 0)
    (define g 0)
    (define dv 0)
    (define cnt 0)
    (define base 0)
    (define x0 0.0)
    (define p 0)
    (define q 0)
    (define tx 0.0)
    (define ty 0.0)
    (define dy 0.0)
    (define hue 0.0)
    (define rp 0)
    (set! ACTIVE 0)
    (set! rp (if (> REPT 0) 1 0))        ; 排斥开关只读一次全局
    ;; 每帧按风格切换"表句柄"（三个模块变量，避免逐点判断）
    (if (== STYLE 1)
        { (set! TBB GD_BASE) (set! TBC GD_CNT) (set! TBP GD_PTS) }
        { (set! TBB GO_BASE) (set! TBC GO_CNT) (set! TBP GO_PTS) })
    (set! si 0)
    (while (< si 8) {
      (set! dv (get_item SLOTD si))
      (set! g (if (< dv 0) 10 (get_item DIG dv)))
      ;; 冒号槽：整体上提 COLDY（视觉上与数字行高中心对齐）
      (set! dy (if (< dv 0) (- 0.0 COLDY) 0.0))
      ;; 两套点表（实心 GD_* / 描边 GO_*）按 STYLE 选一套
      (set! cnt (get_item TBC g))
      (set! base (get_item TBB g))
      (set! x0 (get_item SLOTX si))
      (set! hue (+ (get_item HUES PAL) (* si 0.028)))
      (set! j 0)
      (while (< j MAXPT) {
        (if (< j cnt)
            {
              (set! p (+ (* si MAXPT) j))
              (set! q (* 2 (+ base j)))       ; 点表里该点的下标
              (set! tx (+ x0 (get_item TBP q)))
              (set! ty (+ (+ Y0 (get_item TBP (+ q 1))) dy))
              (step_particle p tx ty hue t #t rp)
              (set! ACTIVE (+ ACTIVE 1))
            }
            #f)
        (set! j (+ j 1))
      })
      (set! si (+ si 1))
    })))

;; ---- 分钟切换：把整团粒子完全打乱，再让弹簧把它们重新聚成新数字 ----------
;; 每颗粒子的位置/速度都重新随机（全屏范围 + 一点从画面中心向外的初速），
;; 之后的每一拍照常走 `step_particle` 的弹簧 + 热噪声 —— 于是能看到"炸散 → 聚拢"。
;; 代价：约 8×MAXPT 次表写入，只在整分钟发生一次，可忽略。
(define scramble
  (lambda ()
    (define p 0)
    (define n (* 8 MAXPT))
    (set! p 0)
    (while (< p n) {
      (set_item! GX p (* (Math.random) 320.0))
      (set_item! GY p (* (Math.random) 240.0))
      (set_item! GVX p (* 0.055 (- (get_item GX p) 160.0)))
      (set_item! GVY p (* 0.055 (- (get_item GY p) 120.0)))
      (set! p (+ p 1))
    })
    ;; 进入"重组冲刺"：接下来 18 拍用直接指数趋近把粒子收成字形
    (set! BOOST 18)))

;; ---- 每拍 ----------------------------------------------------------------
(define tick
  (lambda ()
    (define now 0)
    (define w0 0)
    (define mm 0)
    (define ss 0)
    (set! w0 (Diag.ms))
    (set! now (- w0 LASTMS))
    (set! LASTMS w0)
    (if (> now 200) (set! now 33) #f)
    (set! T (+ T (/ now 1000.0)))
    (if (> BOOST 0) (set! BOOST (- BOOST 1)) #f)
    (EX.check)
    ;; ---- 触屏：按下沿先判按钮；不在按钮上则作为"排斥扰动" ----
    (set! RTX (Touch.x))
    (set! RTY (Touch.y))
    (set! PRESSED (Touch.is_pressed))
    (if (> GUARD 0)
        { (set! GUARD (- GUARD 1)) (Touch.take_press) (Touch.take_release) }
        #f)
    (if (and (== GUARD 0) (Touch.take_press))
        (cond ((in_rect RTX RTY B1X B1Y B1W B1H)
               { (set! BHOLD 1) (set! STYLE (Math.floor (mod (+ STYLE 1) 2))) })
              ((in_rect RTX RTY B2X B2Y B2W B2H)
               { (set! BHOLD 2) (set! PAL (Math.floor (mod (+ PAL 1) 6))) })
              ((in_rect RTX RTY B3X B3Y B3W B3H)
               { (set! BHOLD 3) (set! RENDER (Math.floor (mod (+ RENDER 1) 3))) })
              ((in_rect RTX RTY B4X B4Y B4W B4H)
               { (set! BHOLD 4)
                 ;; 循环顺序：波纹（现状）→ 随机 → 常亮 → 波纹 …（第一下就切到"随机"便于对比）
                 (set! TWK (if (== TWK 1) 0 (if (== TWK 0) 2 1))) })
              (else { (set! BHOLD 0) (set! REPT 8) }))
        #f)
    (if (Touch.take_release) (set! BHOLD 0) #f)
    ;; 按住（且不是按在按钮上）→ 持续排斥；松手后 REPT 递减到 0，弹簧自然把粒子收回
    (if (and PRESSED (== BHOLD 0) (== REPT 0)) (set! REPT 8) #f)
    (if (> REPT 0) (set! REPT (- REPT 1)) #f)
    (read_time)
    ;; 分钟切换 → 全量打乱（首拍只记录分钟序号，不炸）
    (set! mm (Math.floor (/ (mod (+ (Time.utc_sod) TZ_SEC) 86400) 60)))
    (cond ((== MINNOW -1) (set! MINNOW mm))
          ((not (== MINNOW mm))
           { (set! MINNOW mm)
             (scramble)
             (display "[cg] scramble min=") (display mm) (newline) })
          (else #f))
    ;; ---- 波纹档的脉冲：整秒对齐（数字换秒的同一拍重新发一个），其余按 dt 推进 ----
    (set! ss (Math.floor (mod (+ (Time.utc_sod) TZ_SEC) 60)))
    (if (not (== ss SSNOW))
        { (set! SSNOW ss) (set! PHASE 0.0) }            ; 新的一秒：脉冲从左边重新出发
        (set! PHASE (+ PHASE (/ now 1000.0))))          ; 否则照常推进
    (if (< PHASE PKT)
        (set! PX (+ -70.0 (* (/ PHASE PKT) 460.0)))     ; 0.7s 从 -70 扫到 390
        (set! PX 999.0))                               ; 本秒已扫完 → 屏外（无脉冲）
    (draw_bg T)
    (draw_dust T)
    (draw_clock T)
    (draw_buttons)
    (EX.draw_button)
    (Gfx.refresh)
    (set! FRAMES (+ FRAMES 1))
    (set! ACC (+ ACC (- (Diag.ms) w0)))
    (if (>= FRAMES 30)
        {
          (display "[cg] pts=") (display ACTIVE)
          (display " ms=") (display (/ ACC 30.0))
          (display " pal=") (display PAL)
          (display " style=") (display STYLE) (display " rep=") (display REPT)
          (display " rnd=") (display RENDER) (display " twk=") (display TWK)
          (newline)
          (set! FRAMES 0)
          (set! ACC 0.0)
        }
        #f)))

;; ---- 启动 ----------------------------------------------------------------
(define _timer 0)

(EX.install)
(build_layout)
(build_particles)
(set! LASTMS (Diag.ms))
(read_time)
(draw_bg 0.0)
(draw_dust 0.0)
(draw_clock 0.0)
(EX.draw_button)
(Gfx.refresh)
(set! _timer (System.set_interval TICK_MS tick))
