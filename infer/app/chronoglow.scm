    (set! _hf (- _h6 _hi))
    (set! _p (* v (- 1.0 s)))
    (set! _q (* v (- 1.0 (* s _hf))))
    (set! _w (* v (- 1.0 (* s (- 1.0 _hf)))))
    (cond ((< _hi 1.0) { (set! HR (* v 255.0)) (set! HG (* _w 255.0)) (set! HB (* _p 255.0)) })
          ((< _hi 2.0) { (set! HR (* _q 255.0)) (set! HG (* v 255.0)) (set! HB (* _p 255.0)) })
          ((< _hi 3.0) { (set! HR (* _p 255.0)) (set! HG (* v 255.0)) (set! HB (* _w 255.0)) })
          ((< _hi 4.0) { (set! HR (* _p 255.0)) (set! HG (* _q 255.0)) (set! HB (* v 255.0)) })
          ((< _hi 5.0) { (set! HR (* _w 255.0)) (set! HG (* _p 255.0)) (set! HB (* v 255.0)) })
          (else       { (set! HR (* v 255.0)) (set! HG (* _p 255.0)) (set! HB (* _q 255.0)) }))))

;; ---- 启动：算槽位与粒子容量 ----------------------------------------------
(define build_layout
  (lambda ()
    (define i 0)
    (define x 0.0)
    (define w 0.0)
    ;; 单字容量 = 全部字形里的最大点数
    (set! MAXPT 0)
    (set! i 0)
    (while (< i NGLYPH) {
      (if (> (get_item GD_CNT i) MAXPT) (set! MAXPT (get_item GD_CNT i)) #f)
      (set! i (+ i 1))
    })
    ;; 总宽 = 6 个数字 + 2 个冒号（冒号两侧各加 COLMG 边距），水平居中
    (set! w (+ (* 6.0 GD_ADV) (* 2.0 (+ GD_CADV (* 2.0 COLMG)))))
    (set! X0 (/ (- 320.0 w) 2.0))
    (set! CLKW w)
    (set! SLOTX (cons 0.0 '())) (pop SLOTX)
    (set! x X0)
    (set! i 0)
    (while (< i 8) {
      (if (== (get_item SLOTD i) -1)
          { (push SLOTX (+ x COLMG)) (set! x (+ (+ x GD_CADV) (* 2.0 COLMG))) }
          { (push SLOTX x) (set! x (+ x GD_ADV)) })
      (set! i (+ i 1))
    })))

(define build_particles
  (lambda ()
    (set! GX (cons 0.0 '())) (pop GX)
    (set! GY (cons 0.0 '())) (pop GY)
    (set! GVX (cons 0.0 '())) (pop GVX)
    (set! GVY (cons 0.0 '())) (pop GVY)
    (define i 0)
    (define n (* 8 MAXPT))          ; 8 个槽（6 数字 + 2 冒号）× 单字容量
    (while (< i n) {
      (push GX (* (Math.random) 320.0))
      (push GY (* (Math.random) 240.0))
      (push GVX 0.0)
      (push GVY 0.0)
      (set! i (+ i 1))
    })
    (set! DX (cons 0.0 '())) (pop DX)
    (set! DY (cons 0.0 '())) (pop DY)
    (set! DVX (cons 0.0 '())) (pop DVX)
    (set! DVY (cons 0.0 '())) (pop DVY)
    (set! i 0)
    (while (< i NDUST) {
      (push DX (* (Math.random) 320.0))
      (push DY (* (Math.random) 240.0))
      (push DVX 0.0)
      (push DVY 0.0)
      (set! i (+ i 1))
    })))

;; ---- 时间 → 6 个数字 ------------------------------------------------------
(define read_time
  (lambda ()
    (define sod (mod (+ (Time.utc_sod) TZ_SEC) 86400))
    (define hh (Math.floor (/ sod 3600.0)))
    (define mm (Math.floor (/ (mod sod 3600.0) 60.0)))
    (define ss (Math.floor (mod sod 60.0)))
    (set_item! DIG 0 (Math.floor (/ hh 10.0)))
    (set_item! DIG 1 (Math.floor (mod hh 10.0)))
    (set_item! DIG 2 (Math.floor (/ mm 10.0)))
    (set_item! DIG 3 (Math.floor (mod mm 10.0)))
    (set_item! DIG 4 (Math.floor (/ ss 10.0)))
    (set_item! DIG 5 (Math.floor (mod ss 10.0)))))

;; ---- 背景：极暗竖直渐变 + 秒进度光带 --------------------------------------
(define draw_bg
  (lambda (t)
    (define i 0)
    (define k 0.0)
    (define ss 0.0)
    (Gfx.clear)
    ;; 12 条 20px 色带做极暗渐变（**不要**用大 fill_circle_aa：代价随面积走，且有硬边）
    (set! i 0)
    (while (< i 12) {
      (set! k (/ (- (Math.abs (- (* i 20.0) 105.0)) 105.0) 105.0))
      (set! k (* k k))
      (Gfx.fill_rect 0.0 (* i 20.0) 320.0 20.0
                     (+ 3.0 (* 9.0 k)) (+ 5.0 (* 13.0 k)) (+ 11.0 (* 24.0 k)))
      (set! i (+ i 1))
    })
    ;; 秒进度：底槽 + 亮带（alpha ≥ 4 才是混合）
    (hsv (get_item HUES PAL) 0.6 1.0)
    (set! ss (mod (+ (Time.utc_sod) TZ_SEC) 60.0))
    (Gfx.fill_rect X0 202.0 CLKW 3.0 8.0 10.0 16.0)
    (Gfx.fill_rect X0 202.0 (* CLKW (/ ss 60.0)) 3.0 (* HR 0.5) (* HG 0.5) (* HB 0.5))))

;; ---- 背景自由粒子（流场漂移，很暗）--------------------------------------
(define draw_dust
  (lambda (t)
    (define i 0)
    (define x 0.0)
    (define y 0.0)
    (define vx 0.0)
    (define vy 0.0)
    (set! i 0)
    (while (< i NDUST) {
      (set! x (get_item DX i))
      (set! y (get_item DY i))
      (set! vx (+ (* (get_item DVX i) 0.94)
                  (* 0.9 (Math.sin (+ (+ (* y 0.021) (* t 0.45)) (* i 0.07))))))
      (set! vy (+ (* (get_item DVY i) 0.94)
                  (* 0.9 (Math.cos (+ (+ (* x 0.018) (- 0.0 (* t 0.38))) (* i 0.05))))))
      (set! x (+ x vx))
      (set! y (+ y vy))
      (if (< x 0.0) (set! x (+ x 320.0)) (if (> x 320.0) (set! x (- x 320.0)) #f))
      (if (< y 0.0) (set! y (+ y 240.0)) (if (> y 240.0) (set! y (- y 240.0)) #f))
      (set_item! DX i x) (set_item! DY i y)
      (set_item! DVX i vx) (set_item! DVY i vy)
      (Gfx.draw_line_aa (- x (* vx 0.5)) (- y (* vy 0.5)) x y 1.0 5.0 9.0 16.0)
      (set! i (+ i 1))
    })))

;; ---- 单颗粒子：弹簧 + 旋涡 + 加色光丝 ------------------------------------
;; (p: 粒子下标, tx/ty: 目标, hue: 基色, t: 秒, glow: 本次是否画高斯辉光)
;; 旋涡用 32 项正弦/余弦表（启动时建好）：每颗粒子每拍只查两次表，
;; 省掉 2 次 Math.sin/cos —— 在 970 颗粒子的规模上就是 ~1.3 ms。
(define STAB '())
(define CTAB '())

(define build_tabs
  (lambda ()
    (set! STAB (cons 0.0 '())) (pop STAB)
    (set! CTAB (cons 0.0 '())) (pop CTAB)
    (define i 0)
    (while (< i 32) {
      (push STAB (Math.sin (* i 0.19635)))
      (push CTAB (Math.cos (* i 0.19635)))
      (set! i (+ i 1))
    })))

;; ---- 高斯辉光：4 层同心 alpha 圆逼近 exp(−r²/2σ²) 的径向衰减 --------------
;; 只有 alpha 圆能做"半透明叠加"（mode ≥ 4 才是 alpha 混合；2 是异或）。
;; 把半径按固定比例收进、每层 alpha 递增，合成的累计不透明度就近似高斯：
;;   层半径 R / 0.70R / 0.45R / 0.22R（σ ≈ R/2.2），
;;   累计不透明度 ≈ 9 / 33 / 70 / 139（0..255），最外圈只剩 ~3.5% → 视觉上"衰减到无"。
;; 单组 ≈ 4 次 fill_circle_aa ≈ 12 µs（R≈8），所以每 4 颗粒子才画一组。
(define halo
  (lambda (x y rad br)
    (Gfx.fill_circle_aa x y rad HR HG HB (* 9.0 br))
    (Gfx.fill_circle_aa x y (* 0.70 rad) HR HG HB (* 26.0 br))
    (Gfx.fill_circle_aa x y (* 0.45 rad) HR HG HB (* 55.0 br))
    (Gfx.fill_circle_aa x y (* 0.22 rad) HR HG HB (* 105.0 br))))

(define step_particle
  (lambda (p tx ty hue t glow)
    (define x 0.0)
    (define y 0.0)
    (define vx 0.0)
    (define vy 0.0)
    (define br 0.0)
    (define sx 0.0)
    (define sy 0.0)
    (define wi 0)
    (define ph 0.0)
    (set! x (get_item GX p))
    (set! y (get_item GY p))
    ;; 两种运动模式：
    ;;  · 常态 —— 弹簧（朝目标）+ 旋涡（位置相关的正弦力 → 绕目标打小圈，"在流动"）；
    ;;  · 重组冲刺（BOOST>0，整分钟打乱后的十几拍）—— 换成**直接指数趋近**：
    ;;    不会过冲、不会振铃，十几拍就能把炸散的粒子干净地收成字形。
    ;;    （用弹簧加速会欠阻尼振铃，粒子在目标附近来回抖，画面糊成一团 —— 实测踩过。）
    (cond ((> BOOST 0)
           { (set! vx (* 0.26 (- tx x)))
             (set! vy (* 0.26 (- ty y)))
             (set! x (+ x vx))
             (set! y (+ y vy))
             (set_item! GVX p 0.0) (set_item! GVY p 0.0) })
          (else
           { (set! wi (Math.floor (mod (+ (* p 0.37) (* t 6.0)) 32.0)))
             (set! ph (* SWL (+ (get_item STAB wi) (get_item CTAB wi))))
             (set! vx (+ (+ (* (get_item GVX p) DMP) (* (- tx x) SPK)) ph))
             (set! vy (+ (+ (* (get_item GVY p) DMP) (* (- ty y) SPK))
                         (* SWL (- (get_item CTAB wi) (get_item STAB wi)))))
             (set! x (+ x vx))
             (set! y (+ y vy))
             (set_item! GVX p vx) (set_item! GVY p vy) }))
    (set_item! GX p x) (set_item! GY p y)
    ;; 光丝：从"沿速度反推 2.4 倍"处画到当前位置（运动模糊）
    (set! br (+ 0.80 (* 0.20 (Math.sin (+ (* t 3.1) (* p 0.37))))))
    (hsv (+ hue (* 0.05 (Math.sin (+ (* p 0.21) (* t 0.9))))) 0.42 1.0)
    ;; 拖尾长度按轴钳到 ±4.5px：粒子从旧字形飞向新字形时速度很大，
    ;; 不钳的话同向的一串拖尾会叠成一块硬边三角形色斑（实测踩到）。
    (set! sx (* vx 2.6))
    (set! sy (* vy 2.6))
    (if (> sx 4.5) (set! sx 4.5) (if (< sx -4.5) (set! sx -4.5) #f))
    (if (> sy 4.5) (set! sy 4.5) (if (< sy -4.5) (set! sy -4.5) #f))
    (Gfx.draw_line_aa (- (- x sx) 1.5) (- (- y sy) 1.5) (+ x 1.5) (+ y 1.5)
                      1.0 (* HR br) (* HG br) (* HB br))
    ;; 高斯辉光（每 3 颗一枚，半径随亮度略增）
    (if glow
        (halo x y (+ 6.5 (* 2.2 br)) br)
        #f)))

;; ---- 一帧：读时间 → 逐槽把粒子拉向字形 -----------------------------------
;; 槽位与字形下标一一对应：数字槽取当前数字（0..9），冒号槽固定 10。
;; 每槽的粒子区间是 [slot*MAXPT, slot*MAXPT + cnt)，cnt 是当前字形的点数；
;; 多出来的槽位粒子本帧不动（下次字形变大时从原处飞回来）。
(define draw_clock
  (lambda (t)
    (define si 0)
    (define j 0)
    (define g 0)
    (define dv 0)
    (define cnt 0)
    (define base 0)
    (define x0 0.0)
    (define p 0)
    (define q 0)
    (define tx 0.0)
    (define ty 0.0)
    (define dy 0.0)
    (define hue 0.0)
    (set! ACTIVE 0)
    (set! si 0)
    (while (< si 8) {
      (set! dv (get_item SLOTD si))
      (set! g (if (< dv 0) 10 (get_item DIG dv)))
      ;; 冒号槽：整体上提 COLDY（视觉上与数字行高中心对齐）
      (set! dy (if (< dv 0) (- 0.0 COLDY) 0.0))
      (set! cnt (get_item GD_CNT g))
      (set! base (get_item GD_BASE g))
      (set! x0 (get_item SLOTX si))
      (set! hue (+ (get_item HUES PAL) (* si 0.028)))
      (set! j 0)
      (while (< j MAXPT) {
        (if (< j cnt)
            {
              (set! p (+ (* si MAXPT) j))
              (set! q (* 2 (+ base j)))       ; GD_PTS 里该点的下标
              (set! tx (+ x0 (get_item GD_PTS q)))
              (set! ty (+ (+ Y0 (get_item GD_PTS (+ q 1))) dy))
              (step_particle p tx ty hue t (== (mod j 4) 0))
              (set! ACTIVE (+ ACTIVE 1))
            }
            #f)
        (set! j (+ j 1))
      })
      (set! si (+ si 1))
    })))

;; ---- 分钟切换：把整团粒子完全打乱，再让弹簧把它们重新聚成新数字 ----------
;; 每颗粒子的位置/速度都重新随机（全屏范围 + 一点从画面中心向外的初速），
;; 之后的每一拍照常走 `step_particle` 的弹簧+旋涡 —— 于是能看到"炸散 → 聚拢"。
;; 代价：约 8×MAXPT 次表写入，只在整分钟发生一次，可忽略。
(define scramble
  (lambda ()
    (define p 0)
    (define n (* 8 MAXPT))
    (set! p 0)
    (while (< p n) {
      (set_item! GX p (* (Math.random) 320.0))
      (set_item! GY p (* (Math.random) 240.0))
      (set_item! GVX p (* 0.055 (- (get_item GX p) 160.0)))
      (set_item! GVY p (* 0.055 (- (get_item GY p) 120.0)))
      (set! p (+ p 1))
    })
    ;; 进入"重组冲刺"：接下来 18 拍用直接指数趋近把粒子收成字形
    (set! BOOST 18)))

;; ---- 每拍 ----------------------------------------------------------------
(define tick
  (lambda ()
    (define now 0)
    (define w0 0)
    (define mm 0)
    (set! w0 (Diag.ms))
    (set! now (- w0 LASTMS))
    (set! LASTMS w0)
    (if (> now 200) (set! now 33) #f)
    (set! T (+ T (/ now 1000.0)))
    (if (> BOOST 0) (set! BOOST (- BOOST 1)) #f)
    (EX.check)
    (if (Touch.take_press)
        (set! PAL (Math.floor (mod (+ PAL 1) 6)))
        #f)
    (read_time)
    ;; 分钟切换 → 全量打乱（首拍只记录分钟序号，不炸）
    (set! mm (Math.floor (/ (mod (+ (Time.utc_sod) TZ_SEC) 86400) 60)))
    (cond ((== MINNOW -1) (set! MINNOW mm))
          ((not (== MINNOW mm))
           { (set! MINNOW mm)
             (scramble)
             (display "[cg] scramble min=") (display mm) (newline) })
          (else #f))
    (draw_bg T)
    (draw_dust T)
    (draw_clock T)
    (EX.draw_button)
    (Gfx.refresh)
    (set! FRAMES (+ FRAMES 1))
    (set! ACC (+ ACC (- (Diag.ms) w0)))
    (if (>= FRAMES 30)
        {
          (display "[cg] pts=") (display ACTIVE)
          (display " ms=") (display (/ ACC 30.0))
          (display " pal=") (display PAL)
          (newline)
          (set! FRAMES 0)
          (set! ACC 0.0)
        }
        #f)))

;; ---- 启动 ----------------------------------------------------------------
(define _timer 0)

(EX.install)
(build_layout)
(build_tabs)
(build_particles)
(set! LASTMS (Diag.ms))
(read_time)
(draw_bg 0.0)
(draw_dust 0.0)
(draw_clock 0.0)
(EX.draw_button)
(Gfx.refresh)
(set! _timer (System.set_interval TICK_MS tick))
