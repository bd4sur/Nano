;@id=genetic
;@title=遗传算法拟合图像
;@version=2026-11-28
;; ============================================================================
;; 遗传算法拟合图像（Genetic Algorithm）—— 灵机应用程序
;;
;; 参考实现：infer/ui_genetic.h（C 版，STATE_GENETIC，"小游戏 → 遗传算法拟合图像"）。
;; 结构逐条对应（三通道各自独立的伊甸园）：基因 = 网格上一个通道的亮度；适应度 = 1/MSE
;; （MSE 为 0 时取 1e30）；精英保留（最优个体进新种群第 0 位）；k 切点排序交叉（落在
;; [p0,p1] 与 [p2,p3] 内取父 A，其余取父 B）；随机单点变异；画面 = 三通道最优个体合成，
;; 居中、每格 4×4 像素；页眉 "演化算法 | 代数:N"；底部 "点此重新演化" 热区。
;;
;; ## 与 C 版的差异（三条，都有实测依据，见 doc/AGENTS.md 的 2026-11-28 条目）
;;
;; ① **算子参数按"墙钟进化速度"实测重选**（不是拍脑袋）：用 C 仿真复刻本算法的每个算子，
;;    以"评估一个基因的 VM 指令量"为统一成本、按实测吞吐（≈630k 基因评估/秒，wasm32）
;;    折算成墙钟时间，扫了 网格 × 种群 × 交叉/变异概率 × 变异量程 × 选择算子：
;;      · 变异量程：C 版 `gene[pos] = random_float()` 写的是 [0,1)，渲染时截断成近黑——
;;        等于把像素抹黑而不是重新取值，变异因此**不提供任何探索**：45 秒后重建误差仍
;;        停在 7800（满分约 11000），几乎不进化。改为全量程 [0,255) 后同一时间降到 1100。
;;      · 选择算子：1/MSE 轮盘赌在种群内只差几个百分点（压力极弱）→ 改 5 元锦标赛；
;;        同样是 45 秒，误差 7800 → 1100（约 7× 差距）。
;;      · 变异概率：1.0 > 0.6 > 0.3 > 0.1（变异是唯一的取值探索手段）。
;;      · 种群：**6**（不是 64）——每代成本正比于 POP，而每代进度在 POP≈6 后饱和，
;;        所以小种群反而更快；交叉概率 0.5/0.9/0.3 差异在噪声内，保留 C 版的 0.5。
;;      · 网格：**16×16 / 32×32 / 64×64** 三档，右上角按钮（或 g/G 键）循环切换
;;        （C 版固定 64×64 = 4096 基因）。浏览器 wasm32 实测（本版管线）：
;;          16×16   256 基因  POP=4  ≈290 代/秒   收敛 ≈3 s    每格 8 px（默认，最快）
;;          32×32  1024 基因  POP=4  ≈175 代/秒   收敛 ≈41 s   每格 4 px
;;          64×64  4096 基因  POP=6   ≈36 代/秒   err≈2e3 @2 min，≈6.7e2 @4 min  每格 2 px
;;        64×64 就是 C 版的分辨率，但它天生慢一个量级：每代成本 ∝ 基因数，而"每代进度"
;;        并不随基因数变快——同一套算子在 4096 基因上要跑几千代才收敛。64 档的搜索结论
;;        与另两档略不同（见下面 ① 的表：POP=6、变异位点仍取 1；位点取 3~4 时前 60 s 更快
;;        但 4 分钟后误差反而高 2 倍）。像素边界由 (build-grid) 的边界表算出来，
;;        不要求 GRID 整除 128。
;; ② **全力计算、低频绘制**：一拍连续推进 BATCH 代（三通道各一代算一代），只每
;;    DRAW_EVERY 代画一帧（默认 24 代 → 16×16 档 ≈12 帧/秒、32×32 档 ≈7.5 帧/秒）。同时把本 App 的解释器
;;    时间片提到上限 (App.set_timeslice 1250000)，减少 JS↔wasm 的帧边界开销，
;;    同样的 VM 时间全部用来进化。
;;    实测 16×16 档 **≈290 代/秒**、32×32 档 ≈175 代/秒（浏览器 wasm32；旧版"每拍一代
;;    三通道 + 每拍推屏"只有 8.8 代/秒，前者 33×），画面上一次还是一片雪花、下一次已经
;;    显出五官（16×16 档 ≈3 s 收敛）。
;;    C 版是每帧 10 代 × 三通道 + 每帧推屏。
;;    顺带实测：绘制本身几乎不占算力——DRAW_EVERY 取 24 / 64 / 128（8 / 3 / 1.5 帧/秒）
;;    时 16×16 档都是 ≈290~300 代/秒（VM 才是瓶颈）。取 24 是为了画面够跟手。
;; ③ **输入采样与计算解耦**：触摸/按键每**代**采样一次（≈10 ms 粒度），而不是每帧一次。
;;    (native Touch) 的边沿是电平采样差分派生的，一拍 >~100 ms 时一次 ~150 ms 的点按
;;    会被整段漏掉（见 am_native_Touch.h）；把采样塞进计算循环内部即可彻底避免。
;;    退出走灵机 App 的统一出口（app/lib/exit.scm：右上角「退出」按钮 + 硬 A/ESC 弹宿主
;;    全局确认框），而不是 C 版直接切回游戏菜单。字体按需求统一用 12px 抗锯齿。
;;
;; ## 其它
;;   · 内联图与 C 版 image_rgb888 逐字节相同（64×64 RGB888，12288 个分量），加载时按
;;     GRID 网格做盒式平均降采样（本版 4×4 → 16×16）；解析期 VM 峰值约 7 MB，
;;     最小可用池 ≈14 MB（WASM 宿主 56/80 MB；ESP32 的 2 MB 池装不下这张表）。
;;   · 精英（种群第 0 位）的适应度上代已算过，`eval-rest` 跳过重算（省 1/POP 评估量）。
;;   · 书写约定（本解释器的坑，详见 app/turtle.scm 头部）：算术/比较恒二元；没有一元取负
;;     （写 (- 0 x)）；/ 与 mod 恒浮点 → 下标一律 Math.floor 收口；不用 let/list/map/append；
;;     define 只写在 lambda 体顶层（循环体的 define 会被提升，可复用同名临时量）；
;;     '() 是模块级静态槽 → 空表一律 (cdr (cons 0 '())) 现造；cond 每子句一个表达式。
;; ============================================================================

(native Gfx)
(native Math)
(native String)
(native System)
(native Touch)
(native Key)
(native App)
(import EX "app/lib/exit.scm")   ; 硬 A/ESC + 右上角按钮 → 宿主全局退出确认框
(import BTN "app/lib/button.scm") ; 通用按钮控件（右上角「16×16 / 32×32 / 64×64」切换钮）

;; ---- 画布与布局 -------------------------------------------------------------

(define SW (Gfx.width))                    ; 画布宽（320）
(define SH (Gfx.height))                   ; 画布高（240）

(define IMG_W 128)                         ; 合成图边长（与 C 版 64×2 相同）
;; 三档基因网格（右上角按钮循环切换）：边长 16 / 32 / 64 → 基因数 256 / 1024 / 4096。
;; 每格在屏幕上的像素边界由 (build-grid) 算成边界表 bx/by（GRID+1 项），因此不要求整除 128。
(define grids   '(16 32 64))
(define GRID 16)                           ; 当前网格边长（由 load-grid 设置）
(define N 256)                             ; 当前单通道基因数（GRID²）
(define grid-idx 0)                        ; 当前网格在 grids 里的下标（0=16、1=32、2=64）
(define bx (cdr (cons 0 '())))
(define by (cdr (cons 0 '())))
(define OX (Math.floor (/ (- SW IMG_W) 2)))   ; 图像左上角 x（居中）
(define OY (Math.floor (/ (- SH IMG_W) 2)))   ; 图像左上角 y（居中）

(define HEADER_H 12)                       ; 页眉高（同 C 版 gfx_draw_rectangle(...,12,...)）
(define FOOT_BAND 24)                      ; 底部"点此重新演化"热区（同 ui_app.c 的 STATE_GENETIC）

;; ---- 计算/绘制节拍（见头部 ②③）--------------------------------------------

(define TIMESLICE 1250000)                 ; 本 App 的解释器时间片上限（默认 312500 的 4 倍）
(define TICK_MS 16)                        ; 定时器间隔；实际节拍由"一拍算 BATCH 代"决定
(define BATCH 6)                           ; 每拍推进的完整代数（三通道各一代算一代）
(define DRAW_EVERY 24)                     ; 每多少代画一帧（≈2~3 帧/秒）

;; ---- 算子参数（**逐网格**实测重选，见头部 ① 的两张表）---------------------------
;; 下表下标与 grids 一一对应（16 / 32 / 64）。搜索结论：
;;   16/32 档：POP=4、tour5、pc=0.5、pm=1.0、位点 1（两档完全相同）
;;   64 档  ：POP=6、其余同上（POP 4/5/6/8 × 位点 1/2/3/4 实测，见 doc/AGENTS.md）
;; （POP=4、锦标赛 5 元、交叉 0.5、每子代 1 个变异位点、变异取值全量程 255），
;; 差别只在网格本身（→ 代速率与收敛时间）。若以后某一档要单独调，改对应元素即可。

(define cfg-pop   '(4 4 6))                  ; 种群规模（C 版 64）；64 档实测 6 最快
(define cfg-tour  '(5 5 5))                  ; 锦标赛选择规模（C 版是轮盘赌）
(define cfg-pc    '(0.5 0.5 0.5))            ; 交叉概率（同 C 版 G_CROSSOVER_PROB）
(define cfg-pm    '(1.0 1.0 1.0))            ; 变异概率（C 版 0.1）
(define cfg-sites '(1 1 1))                  ; 每个子代的变异位点数（C 版固定 1）
(define MUT_RANGE 255)                     ; 变异取值上界（C 版写 [0,1)，见头部 ①）

(define POP 4)                             ; 当前种群规模（由 load-grid 按 cfg-pop 设置）
(define TOUR_K 5)                          ; 当前锦标赛规模
(define P_CROSS 0.5)                       ; 当前交叉概率
(define P_MUT 1.0)                         ; 当前变异概率
(define MUT_SITES 1)                       ; 当前变异位点数

;; ---- 模块级状态 -------------------------------------------------------------
;; 三个"伊甸园"各自：参考向量 ref / 种群 pop（POP 个个体的表）/ 适应度 fit（POP 个浮点）
;; 约定：pop 的第 0 个个体永远是上一代的最优个体（精英保留，同 C 版 next_generation），
;; 其适应度缓存在 bfit-* 里（避免每代重算）。

(define gen 0)                             ; 代数（三通道各推进一代算一代）
(define draw-gen 0)                        ; 上次绘制时的代数（控制绘制节流）
(define ref-r '()) (define ref-g '()) (define ref-b '())
(define pop-r '()) (define pop-g '()) (define pop-b '())
(define fit-r '()) (define fit-g '()) (define fit-b '())
(define bfit-r 0.0) (define bfit-g 0.0) (define bfit-b 0.0)   ; 精英适应度缓存
(define out-total 0.0)                     ; 求值输出：适应度总和
(define out-best 0)                        ; 求值输出：最优个体下标
(define out-max 0.0)                       ; 求值输出：最优适应度
(define tick-timer 0)
(define down-x 0) (define down-y 0)        ; 本次点按的按下位置（松手时判定热区）

;; 交叉用的四个切点表（模块级、只在加载时建一次；每次交叉原地覆写 + 冒泡排序）
(define cuts (cdr (cons 0 '(0 0 0 0))))

;; 右上角「16×16」网格切换钮（几何在启动块里设；样式与「退出」钮同一套深色系）
(define gbtn (BTN.new))

;; ---- 随机数 ---------------------------------------------------------------
;; (Math.random) 返回 [0,1) 且由宿主按时间播种，够用且无需自造 LCG。
;; rnd-int 与 C 版 g_random_int(n) 同义：返回 [0,n) 的整数（浮点经 Math.floor 收口）。

(define rnd-int (lambda (n) (Math.floor (* n (Math.random)))))

;; ---- 每格的像素边界表 ------------------------------------------------------

(define build-grid
  (lambda () {
    (define i 0)
    (set! bx (cdr (cons 0 '())))
    (set! by (cdr (cons 0 '())))
    (while (<= i GRID) {
      (push bx (Math.floor (/ (* i IMG_W) GRID)))
      (push by (Math.floor (/ (* i IMG_W) GRID)))
      (set! i (+ i 1)) })
  }))

;; ---- 参考向量：64×64 RGB888 → 三张 GRID×GRID 的盒式平均通道表 -----------------
;; 映射与绘制端**同一套**：像素 (x,y) 属于格子 (floor(y*GRID/64), floor(x*GRID/64))。
;; 因此 GRID 不必整除 64（16/32 是整块，24 是 2~3 px 的块），每个格子取其覆盖像素的平均值，
;; 整幅参考图始终覆盖完整的 64×64（早期版本用 FAC=floor(64/GRID) 采样，GRID=24 时只覆盖
;; 左上 48×48 的一块——画出来是"被裁掉一角的图"，与仿真对不上）。
;; 代价：一次 4096 像素 × (3 读图 + 3 读累加表 + 3 写累加表) ≈ 5 万次本地库/内建调用
;; （≈50 ms，只在启动与切网格时发生一次）。

(define build-refs
  (lambda () {
    (define sr (cdr (cons 0 '())))
    (define sg (cdr (cons 0 '())))
    (define sb (cdr (cons 0 '())))
    (define cnt (cdr (cons 0 '())))
    (define y 0) (define x 0) (define i 0)
    (define c 0) (define idx 0) (define n 0)
    ;; 先铺 GRID² 个 0（累加器 + 计数）
    (while (< i N) {
      (push sr 0.0) (push sg 0.0) (push sb 0.0) (push cnt 0)
      (set! i (+ i 1)) })
    (while (< y SRCW) {
      (set! x 0)
      (while (< x SRCW) {
        (set! c (+ (* (Math.floor (/ (* y GRID) SRCW)) GRID)
                   (Math.floor (/ (* x GRID) SRCW))))
        (set! idx (* (+ (* y SRCW) x) 3))
        (set_item! sr c (+ (get_item sr c) (get_item image_rgb888 idx)))
        (set_item! sg c (+ (get_item sg c) (get_item image_rgb888 (+ idx 1))))
        (set_item! sb c (+ (get_item sb c) (get_item image_rgb888 (+ idx 2))))
        (set_item! cnt c (+ (get_item cnt c) 1))
        (set! x (+ x 1)) })
      (set! y (+ y 1)) })
    ;; 求平均
    (set! i 0)
    (while (< i N) {
      (set! n (get_item cnt i))
      (set_item! sr i (/ (get_item sr i) n))
      (set_item! sg i (/ (get_item sg i) n))
      (set_item! sb i (/ (get_item sb i) n))
      (set! i (+ i 1)) })
    (set! ref-r sr)
    (set! ref-g sg)
    (set! ref-b sb)
  }))

;; 原图边长（内联数据的 64×64）；放在这里是为了让 build-refs 的 FAC 读起来清楚
(define SRCW 64)

;; ---- 种群：POP 个个体，每个个体是 N 个 [0,255) 的整数（同 g_individual_init）----

(define new-pop
  (lambda () {
    (define pop (cdr (cons 0 '())))
    (define g '())
    (define j 0)
    (define k 0)
    (while (< j POP) {
      (set! g (cdr (cons 0 '())))
      (set! k 0)
      (while (< k N) {
        (push g (rnd-int 255))
        (set! k (+ k 1)) })
      (push pop g)
      (set! j (+ j 1)) })
    pop}))

(define new-fits
  (lambda () {
    (define f (cdr (cons 0 '())))
    (define j 0)
    (while (< j POP) { (push f 0.0) (set! j (+ j 1)) })
    f}))

;; ---- 适应度：MSE（同 g_mse / g_individual_decode）---------------------------

(define mse
  (lambda (ref g) {
    (define k 0)
    (define s 0.0)
    (define d 0.0)
    (while (< k N) {
      (set! d (- (get_item ref k) (get_item g k)))
      (set! s (+ s (* d d)))
      (set! k (+ k 1)) })
    s}))

;; 完整求值（首次/重开时用）：填满 fit、累加总适应度、记下最优；返回最优适应度
(define eval-all
  (lambda (ref pop fit) {
    (define j 0)
    (define mv -1.0)
    (define mi 0)
    (define tot 0.0)
    (define m 0.0)
    (define f 0.0)
    (while (< j POP) {
      (set! m (mse ref (get_item pop j)))
      (set! f (if (<= m 0.0) 1e30 (/ 1.0 m)))
      (set_item! fit j f)
      (set! tot (+ tot f))
      (if (>= f mv) { (set! mv f) (set! mi j) } #f)
      (set! j (+ j 1)) })
    (set! out-total tot)
    (set! out-best mi)
    (set! out-max mv)
    mv}))

;; 常规求值：pop[0] 是精英（上代最优，基因表原样搬过来的），其适应度已知（bfit），
;; 只算 1..POP-1 —— 省 1/POP 的评估量（POP=6 时约 15% 的每代成本）。
(define eval-rest
  (lambda (ref pop fit bfit) {
    (define j 1)
    (define mv bfit)
    (define mi 0)
    (define tot bfit)
    (define m 0.0)
    (define f 0.0)
    (set_item! fit 0 bfit)
    (while (< j POP) {
      (set! m (mse ref (get_item pop j)))
      (set! f (if (<= m 0.0) 1e30 (/ 1.0 m)))
      (set_item! fit j f)
      (set! tot (+ tot f))
      (if (>= f mv) { (set! mv f) (set! mi j) } #f)
      (set! j (+ j 1)) })
    (set! out-total tot)
    (set! out-best mi)
    (set! out-max mv)
  }))

;; ---- 选择：k 元锦标赛（C 版是 1/MSE 轮盘赌；实测锦标赛快约 7 倍，见头部 ①）------

(define pick
  (lambda (fit) {
    (define b (rnd-int POP))
    (define t 1)
    (define c 0)
    (while (< t TOUR_K) {
      (set! c (rnd-int POP))
      (if (> (get_item fit c) (get_item fit b)) (set! b c) #f)
      (set! t (+ t 1)) })
    b}))

;; ---- 基因复制：把 src 的 [k0,k1) 段追加到 dst 尾部 -------------------------
;; 用 push 逐项搬（表只能顺序追加）；整段复制用 (cdr (cons 0 lst)) —— cons/cdr 是
;; C 侧整表拷贝，两条 VM 指令就完成一次 memcpy（各 App 通用手法）。

(define copyseg
  (lambda (dst src k0 k1) {
    (define k k0)
    (while (< k k1) {
      (push dst (get_item src k))
      (set! k (+ k 1)) })
  }))

;; ---- 交叉（同 g_individual_crossover）-------------------------------------
;; 四个随机切点排序后：落在 [p0,p1] 或 [p2,p3] 内的基因取父 a，其余取父 b。
;; 展开成五段顺序拷贝（B, A, B, A, B），每段一次 while 循环，避免逐格分支判断。

(define cut-sort
  (lambda () {
    (define i 0)
    (define j 0)
    (define t 0)
    (while (< i 3) {
      (set! j 0)
      (while (< j (- 3 i)) {
        (if (> (get_item cuts j) (get_item cuts (+ j 1)))
            { (set! t (get_item cuts j))
              (set_item! cuts j (get_item cuts (+ j 1)))
              (set_item! cuts (+ j 1) t) }
            #f)
        (set! j (+ j 1)) })
      (set! i (+ i 1)) })
  }))

(define crossover
  (lambda (a b) {
    (define child (cdr (cons 0 '())))
    (set_item! cuts 0 (rnd-int N))
    (set_item! cuts 1 (rnd-int N))
    (set_item! cuts 2 (rnd-int N))
    (set_item! cuts 3 (rnd-int N))
    (cut-sort)
    (define p0 (get_item cuts 0))
    (define p1 (+ (get_item cuts 1) 1))   ; C 版上界是闭区间
    (define p2 (get_item cuts 2))
    (define p3 (+ (get_item cuts 3) 1))
    (copyseg child b 0 p0)
    (copyseg child a p0 p1)
    (copyseg child b p1 p2)
    (copyseg child a p2 p3)
    (copyseg child b p3 N)
    child}))

;; ---- 繁殖一代（同 g_eden_next_generation；算子参数见头部 ①）-------------------

(define breed
  (lambda (pop fit) {
    (define np (cdr (cons 0 '())))
    (define c 1)
    (define pa '())
    (define pb '())
    (define ch '())
    (define pos 0)
    (define m 0)
    (push np (get_item pop out-best))            ; 精英保留（共享同一张基因表：后代只读）
    (while (< c POP) {
      (set! pa (get_item pop (pick fit)))
      (if (<= (Math.random) P_CROSS)
          { (set! pb (get_item pop (pick fit)))
            (set! ch (crossover pa pb)) }
          (set! ch (cdr (cons 0 pa))))          ; 不交叉：整份复制一份再交给变异
      (if (<= (Math.random) P_MUT)
          { (set! m 0)
            (while (< m MUT_SITES) {
              (set! pos (rnd-int N))
              (set_item! ch pos (* MUT_RANGE (Math.random)))
              (set! m (+ m 1)) }) }
          #f)
      (push np ch)
      (set! c (+ c 1)) })
    np}))

;; 一个通道推进一代：求值（跳过精英）+ 繁殖，返回新种群（第 0 位即本代最优）
(define evolve
  (lambda (ref pop fit bfit) {
    (eval-rest ref pop fit bfit)
    (breed pop fit)}))

;; ---- 绘制 ------------------------------------------------------------------

;; 合成图：三个通道的最优个体逐格取色，每格 CELL×CELL 像素（同 C 版 2×2 逐点写，
;; 这里改用一次 fill_rect —— 解释器里 4 次 set_pixel 要 4 次本地库调用，不划算）
(define draw-image
  (lambda () {
    (define gr (get_item pop-r 0))
    (define gg (get_item pop-g 0))
    (define gb (get_item pop-b 0))
    (define gy 0)
    (define gx 0)
    (define k 0)
    (define x0 0) (define x1 0) (define y0 0) (define y1 0)
    (while (< gy GRID) {
      (set! y0 (+ OY (get_item by gy)))
      (set! y1 (+ OY (get_item by (+ gy 1))))
      (set! gx 0)
      (while (< gx GRID) {
        (set! x0 (+ OX (get_item bx gx)))
        (set! x1 (+ OX (get_item bx (+ gx 1))))
        (set! k (+ (* gy GRID) gx))
        (Gfx.fill_rect x0 y0 (- x1 x0) (- y1 y0)
                       (get_item gr k) (get_item gg k) (get_item gb k))
        (set! gx (+ gx 1)) })
      (set! gy (+ gy 1)) })
  }))

;; 整屏一帧：清屏 → 合成图 → 页眉（深灰底 + 12px 抗锯齿字）→ 底部提示 → 右上角「退出」
;; → 推屏。clear 是必须的：图像区只占中间 128×128，启动画面（"正在启动…请稍候"）与宿主
;; 退出确认框都会在图像区之外的像素上留痕，靠每帧清屏擦掉（一次本地库调用，C 侧整屏填）。
(define draw-frame
  (lambda () {
    (Gfx.set_font 1)                     ; 12px 抗锯齿（全 App 统一）
    (Gfx.clear)
    (draw-image)
    (Gfx.fill_rect 0 0 SW HEADER_H 39 39 39)
    (Gfx.draw_text (String.concat "演化算法 | 代数:" (String.atom_to_string gen)) 0 0 255 255 255)
    (Gfx.draw_text_centered 1 "点此重新演化" (Math.floor (/ SW 2)) (- SH 12) 255 255 255 1)
    (EX.draw_button)
    (BTN.draw_state gbtn (BTN.armed gbtn))   ; 右上角「16×16 / 32×32 / 64×64」切换钮
    (Gfx.refresh)
  }))

;; 按钮上的网格标签（"16×16" / "32×32" / "64×64"）
(define grid-label
  (lambda ()
    (String.concat (String.atom_to_string GRID) (String.concat "×" (String.atom_to_string GRID)))))

;; ---- 换网格：按 grids[idx] 重建参考向量、种群与算子参数 --------------------
;; 说明：三档各自独立演化，**切过去就是重新撒种**（不保留上一次的进度），与"重新演化"同义；
;; 参考向量按新网格重新降采样（64→GRID），像素边界表随之重建。

(define load-grid
  (lambda (idx) {
    (set! grid-idx idx)
    (set! GRID (get_item grids idx))
    (set! N (* GRID GRID))
    (set! POP (get_item cfg-pop idx))
    (set! TOUR_K (get_item cfg-tour idx))
    (set! P_CROSS (get_item cfg-pc idx))
    (set! P_MUT (get_item cfg-pm idx))
    (set! MUT_SITES (get_item cfg-sites idx))
    (build-grid)
    (build-refs)
    (set! pop-r (new-pop))
    (set! pop-g (new-pop))
    (set! pop-b (new-pop))
    (set! fit-r (new-fits))
    (set! fit-g (new-fits))
    (set! fit-b (new-fits))
    (set! bfit-r (eval-all ref-r pop-r fit-r))
    (set! bfit-g (eval-all ref-g pop-g fit-g))
    (set! bfit-b (eval-all ref-b pop-b fit-b))
    (set! gen 0)
    (set! draw-gen 0)
    (BTN.set_label gbtn (grid-label))
    (display "GENETIC grid=") (display GRID) (newline)   ; 诊断行（回归脚本断言用）
    (draw-frame)
  }))

;; 循环切换 16 → 32 → 64 → 16
(define cycle-grid
  (lambda () {
    (define i (+ grid-idx 1))
    (if (>= i 3) (set! i 0) #f)
    (load-grid i)
  }))

;; 每代采样一次：网格按钮（(BTN.track) 吞掉落在按钮内的按下/松开沿）
(define handle-grid
  (lambda () {
    (if (BTN.track gbtn) (cycle-grid) #f)
  }))

;; ---- 交互 ------------------------------------------------------------------
;; 退出：硬 A/ESC 与右上角按钮 → 宿主全局确认框（app/lib/exit.scm）。
;; 重新演化：回车 / D 键（同 C 版的 NANO_KEY_enter 与"D 重新演化"）、或点按底部热区。

(define restart
  (lambda () {
    ;; 诊断行（回归脚本按它断言"重新演化"生效，风格同 EXBTN / [tetris] 各诊断行）
    (display "GENETIC restart") (newline)
    (set! gen 0)
    (set! draw-gen 0)
    (set! pop-r (new-pop))
    (set! pop-g (new-pop))
    (set! pop-b (new-pop))
    (set! bfit-r (eval-all ref-r pop-r fit-r))
    (set! bfit-g (eval-all ref-g pop-g fit-g))
    (set! bfit-b (eval-all ref-b pop-b fit-b))
    (draw-frame)
  }))

(define handle-keys
  (lambda () {
    (define k 0)
    (set! k (Key.take_press))
    (while (not (== k 0)) {
      (if (or (== k 13) (== k 100) (== k 68)) (restart) #f)
      (if (or (== k 103) (== k 71)) (cycle-grid) #f)   ; g/G：切换网格 16/32/64
      (set! k (Key.take_press)) })
  }))

;; 点按热区：按下记起点、松手时判定（与 C 版"松手沿 + touch_down_y"同一口径，
;; 手指滑出条带即取消）。落在右上角「退出」按钮内的一下手势已被 (EX.check) 吞掉。
(define handle-touch
  (lambda () {
    (if (Touch.take_press)
        { (set! down-x (Touch.x)) (set! down-y (Touch.y)) }
        #f)
    (if (Touch.take_release)
        (if (>= down-y (- SH FOOT_BAND)) (restart) #f)
        #f)
  }))

;; ---- 一代（三通道各一代） ---------------------------------------------------

(define step-one
  (lambda () {
    (set! pop-r (evolve ref-r pop-r fit-r bfit-r))
    (set! bfit-r out-max)
    (set! pop-g (evolve ref-g pop-g fit-g bfit-g))
    (set! bfit-g out-max)
    (set! pop-b (evolve ref-b pop-b fit-b bfit-b))
    (set! bfit-b out-max)
    (set! gen (+ gen 1))
  }))

;; ---- 每一拍：连续算 BATCH 代，输入每代采样，绘制按代数节流 --------------------
;; 顺序（每代）：退出检查（硬 A/ESC + 右上角按钮）→ 键 → 触摸 → 三通道各一代；
;; 拍尾若距上次绘制已过 DRAW_EVERY 代，则整屏重绘 + 推屏。
;; 为什么输入塞在代循环里：一拍要算 BATCH 代（数十 ms），触摸边沿靠电平差分派生，
;; 采样粒度必须远小于一次点按（~150 ms）——每代一次（≈10 ms）就完全够了。

(define tick
  (lambda () {
    (define i 0)
    (while (< i BATCH) {
      (EX.check)
      (handle-grid)
      (handle-keys)
      (handle-touch)
      (step-one)
      (set! i (+ i 1)) })
    (if (>= (- gen draw-gen) DRAW_EVERY)
        { (draw-frame) (set! draw-gen gen) }
        #f)
  }))

