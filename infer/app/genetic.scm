(BTN.set_font gbtn 1)
(BTN.set_text_color gbtn 225 228 235)
(BTN.set_bg gbtn 60 62 74)
(BTN.set_active_bg gbtn 116 172 226)
(BTN.set_border gbtn 120 124 140)
(BTN.set_radius gbtn 4)
(BTN.set_pos gbtn (- SW 108) 2)         ; 320-108 = 212
(BTN.set_size gbtn 52 16)
(BTN.set_label gbtn "16×16")

